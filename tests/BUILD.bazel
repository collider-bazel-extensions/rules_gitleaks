"""Tests for rules_gitleaks. Secrets in fixtures are fake and generated at
build time (make_fixture.sh), so the repository holds none. Targets that
scan fixtures carry `no-gitleaks`, so gitleaks_aspect over //... passes."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//:defs.bzl",
    "gitleaks_check",
    "gitleaks_config_test",
    "gitleaks_rule_test",
    "gitleaks_scan",
    "gitleaks_test",
    "gitleaks_workspace_test",
)
load(":analysis_tests.bzl", "analysis_test_suite")
load(":fixtures.bzl", "baseline", "fixture", "fixture_tree")

exports_files(["make_fixture.sh"])

_NO = ["no-gitleaks"]

fixture(name = "aws_ini", kind = "aws", out = "leaky/aws.ini")
fixture(name = "github_yaml", kind = "github", out = "leaky/ci.yaml")
fixture(name = "allowed_yaml", kind = "allowed", out = "leaky/allowed.yaml")
fixture(name = "corp_txt", kind = "corp", out = "leaky/corp.txt")
fixture(name = "corp_doc_txt", kind = "corp_doc", out = "leaky/corp_doc.txt")
fixture_tree(name = "tree")

_LEAKY = [
    ":allowed_yaml",
    ":aws_ini",
    ":github_yaml",
    ":tree",
]

# ---- gitleaks_test ------------------------------------------------------------

# Dogfood: this repository's own sources, and a `gitleaks:allow` line.
gitleaks_test(
    name = "clean_test",
    srcs = [
        ":allowed_yaml",
        "//:defs.bzl",
        "//:MODULE.bazel",
        "//private:srcs",
        "//tools:update_checksums.sh",
    ] + glob(["*.sh", "*.bzl"]),
    tags = _NO,
)

# Run by leak_detection_test, which expects it to fail.
gitleaks_test(
    name = "leaky_scan",
    srcs = _LEAKY,
    sarif = True,
    tags = _NO + ["manual"],
)

sh_test(
    name = "leak_detection_test",
    srcs = ["leak_detection_test.sh"],
    args = ["$(rootpath :leaky_scan)"],
    data = [":leaky_scan"],
    tags = _NO,
)

gitleaks_test(
    name = "ignore_test",
    srcs = _LEAKY,
    ignore = "//tests/testdata:all_fixtures.gitleaksignore",
    tags = _NO,
)

baseline(
    name = "leaky_baseline",
    srcs = _LEAKY,
    tags = _NO,
)

gitleaks_test(
    name = "baseline_test",
    srcs = _LEAKY,
    baseline = ":leaky_baseline",
    tags = _NO,
)

# Only a rule that doesn't fire on the fixtures.
gitleaks_test(
    name = "enable_rules_test",
    srcs = _LEAKY,
    enable_rules = ["slack-bot-token"],
    tags = _NO,
)

# A custom config: the corp token is found, its documented example isn't.
gitleaks_test(
    name = "custom_config_clean_test",
    srcs = [":corp_doc_txt"],
    config = "//tests/testdata:corp",
    tags = _NO,
)

# ---- gitleaks_check -----------------------------------------------------------

# Built by `bazel build //...`: a generated file that must stay clean.
gitleaks_check(
    name = "generated_check",
    srcs = [":corp_doc_txt"],
    config = "//tests/testdata:corp",
    tags = _NO,
)

# CI: `bazel build //tests:leaky_check` must fail.
gitleaks_check(
    name = "leaky_check",
    srcs = [":corp_txt"],
    config = "//tests/testdata:corp",
    tags = _NO + ["manual"],
)

# ---- gitleaks_rule_test -------------------------------------------------------

gitleaks_rule_test(
    name = "corp_rules_test",
    clean = [
        ":allowed_yaml",
        ":corp_doc_txt",
    ],
    config = "//tests/testdata:corp",
    leaks = {
        ":aws_ini": "aws-access-token, generic-api-key",
        ":corp_txt": "corp-token",
        ":github_yaml": "github-pat",
    },
    tags = _NO,
)

# Wrong on purpose: run by rule_test_failure_test.
gitleaks_rule_test(
    name = "wrong_rule_test",
    clean = [
        ":aws_ini",
        ":corp_doc_txt",
    ],
    config = "//tests/testdata:corp",
    leaks = {":corp_txt": "github-pat"},
    tags = _NO + ["manual"],
)

sh_test(
    name = "rule_test_failure_test",
    srcs = ["rule_test_failure_test.sh"],
    args = ["$(rootpath :wrong_rule_test)"],
    data = [":wrong_rule_test"],
    tags = _NO,
)

# ---- gitleaks_config ----------------------------------------------------------

# The config check through the public gitleaks_config_test: a good config
# passes; each bad one fails with its message.
[gitleaks_config_test(
    name = "config_" + name + "_test",
    src = "//tests/testdata:{}.toml".format(name),
    expect_error = error,
) for name, error in [
    ("corp", ""),
    ("typo", "rule 'corp-token' allowlists\\[0\\]: unknown key 'pathss'"),
    ("extend_url", "\\[extend\\] url: not supported"),
    ("bad_regex", "error parsing regexp: missing closing \\)"),
    ("bad_toml", "not valid TOML"),
    ("no_id", "rule \\|id\\| is missing or empty"),
]]

# The same two with the vendored tomli forced (as on Python < 3.11).
[gitleaks_config_test(
    name = "config_" + name + "_vendored_toml_test",
    src = "//tests/testdata:{}.toml".format(name),
    env = {"RULES_GITLEAKS_VENDORED_TOML": "1"},
    expect_error = error,
) for name, error in [
    ("corp", ""),
    ("typo", "unknown key 'pathss'"),
]]

# vendored_toml_test checks the vendored parser really ran; the wrong_*
# targets are wrong on purpose, for config_test_failure_test.
gitleaks_config_test(
    name = "wrong_error_config_test",
    src = "//tests/testdata:typo.toml",
    expect_error = "no such message",
    tags = ["manual"],
)

gitleaks_config_test(
    name = "wrong_pass_config_test",
    src = "//tests/testdata:corp.toml",
    expect_error = "anything",
    tags = ["manual"],
)

gitleaks_config_test(
    name = "wrong_fail_config_test",
    src = "//tests/testdata:typo.toml",
    tags = ["manual"],
)

sh_test(
    name = "vendored_toml_test",
    srcs = ["vendored_toml_test.sh"],
    args = ["$(rootpath :config_typo_vendored_toml_test)"],
    data = [":config_typo_vendored_toml_test"],
)

sh_test(
    name = "config_test_failure_test",
    srcs = ["config_test_failure_test.sh"],
    args = [
        "$(rootpath :wrong_error_config_test)",
        "$(rootpath :wrong_pass_config_test)",
        "$(rootpath :wrong_fail_config_test)",
    ],
    data = [
        ":wrong_error_config_test",
        ":wrong_fail_config_test",
        ":wrong_pass_config_test",
    ],
)

# ---- gitleaks_scan ------------------------------------------------------------

gitleaks_scan(
    name = "fixture_scan",
    tags = ["manual"],
)

gitleaks_scan(
    name = "fixture_history_scan",
    mode = "git",
    tags = ["manual"],
)

# tracked_only, over a temp git repo (tracked_scan_test).
gitleaks_scan(
    name = "fixture_tracked_scan",
    config = "//tests/testdata:corp",
    tags = ["manual"],
    tracked_only = True,
)

gitleaks_workspace_test(
    name = "fixture_workspace_test",
    config = "//tests/testdata:corp",
    tags = ["manual"],
)

gitleaks_workspace_test(
    name = "fixture_tree_workspace_test",
    config = "//tests/testdata:corp",
    tags = ["manual"],
    tracked_only = False,
)

sh_test(
    name = "tracked_scan_test",
    srcs = ["tracked_scan_test.sh"],
    args = [
        "$(rootpath :fixture_tracked_scan)",
        "$(rootpath :fixture_workspace_test)",
        "$(rootpath :fixture_tree_workspace_test)",
        "$(rootpath :make_fixture.sh)",
    ],
    data = [
        ":fixture_tracked_scan",
        ":fixture_tree_workspace_test",
        ":fixture_workspace_test",
        ":make_fixture.sh",
    ],
    tags = _NO,
)

sh_test(
    name = "scan_test",
    srcs = ["scan_test.sh"],
    args = [
        "$(rootpath :fixture_scan)",
        "$(rootpath :fixture_history_scan)",
        "$(rootpath :aws_ini)",
        "$(rootpath :github_yaml)",
    ],
    data = [
        ":aws_ini",
        ":fixture_history_scan",
        ":fixture_scan",
        ":github_yaml",
    ],
    tags = _NO,
)

# ---- pins ---------------------------------------------------------------------

sh_test(
    name = "checksums_test",
    srcs = ["checksums_test.sh"],
    data = ["//private:versions.bzl"],
)

sh_test(
    name = "version_test",
    srcs = ["version_test.sh"],
    args = [
        "$(rootpath //private:versions.bzl)",
        "$(rootpath //:MODULE.bazel)",
        "$(rootpath //toolchain:current)",
    ],
    data = [
        "//:MODULE.bazel",
        "//private:versions.bzl",
        "//toolchain:current",
    ],
)

analysis_test_suite(name = "analysis_tests")
